<rdf:RDF xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:qb="http://purl.org/linked-data/cube#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:rtldi="https://rtldi.org/ontology#" xmlns:schema="https://schema.org/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:void="http://rdfs.org/ns/void#" xml:base="https://rtldi.org/atlas/2026/">
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/dataset/rtldi-atlas-2026">
    <rdf:type rdf:resource="http://purl.org/linked-data/cube#DataSet" />
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset" />
    <rdf:type rdf:resource="http://rdfs.org/ns/void#Dataset" />
    <dcterms:title xml:lang="en">RTLDI Atlas 2026: UN Member States computed RTLP scores</dcterms:title>
    <dcterms:description xml:lang="en">Linked open data export of the RTLDI Atlas for 193 UN member states, including computed RTLP score, nine binary RTLP lever values, GDP baseline, potential GDP, and annual capital exclusions in USD.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcterms:issued>
    <dcterms:language>en</dcterms:language>
    <dcterms:source rdf:resource="https://doi.org/10.5281/zenodo.19468550" />
    <qb:structure rdf:resource="https://rtldi.org/atlas/2026/structure/rtldi-observation" />
    <dcat:distribution rdf:resource="https://rtldi.org/atlas/2026/distribution/rdfxml" />
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <void:uriSpace>https://rtldi.org/atlas/2026/</void:uriSpace>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/distribution/rdfxml">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Distribution" />
    <dcterms:title xml:lang="en">RTLDI Atlas 2026 RDF/XML distribution</dcterms:title>
    <dcat:mediaType>application/rdf+xml</dcat:mediaType>
    <dcat:downloadURL rdf:resource="https://rtldi.org/atlas/2026/rtldi_atlas_2026.rdf" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/scheme/rtldi-levers">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel xml:lang="en">RTLDI nine-lever concept scheme</skos:prefLabel>
    <dcterms:description xml:lang="en">The nine binary right-to-life protection levers used to compute national RTLP scores.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/structure/rtldi-observation">
    <rdf:type rdf:resource="http://purl.org/linked-data/cube#DataStructureDefinition" />
    <rdfs:label xml:lang="en">RTLDI national observation structure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#rtlpScore">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">RTLP score</rdfs:label>
    <rdfs:comment xml:lang="en">Computed right-to-life protection score on a 0-1 scale.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#gdpPerCapita">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">GDP per capita</rdfs:label>
    <rdfs:comment xml:lang="en">GDP per capita baseline in current USD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#perCapitaPotential">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Per capita potential</rdfs:label>
    <rdfs:comment xml:lang="en">GDP per capita plus capital exclusions per capita in current USD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#annualGdp">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Annual GDP</rdfs:label>
    <rdfs:comment xml:lang="en">GDP per capita multiplied by population in current USD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#annualPotentialGdp">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Annual potential GDP</rdfs:label>
    <rdfs:comment xml:lang="en">Annual GDP plus capped capital exclusions in current USD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#capitalExclusionUsd">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Capital exclusion USD</rdfs:label>
    <rdfs:comment xml:lang="en">Annual capped capital exclusions in current USD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#capitalExclusionPerCapita">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Capital exclusion per capita</rdfs:label>
    <rdfs:comment xml:lang="en">Annual capped capital exclusions per capita in current USD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#population">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Population</rdfs:label>
    <rdfs:comment xml:lang="en">Population used in the atlas computation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#gdpBaselineYear">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">GDP baseline year</rdfs:label>
    <rdfs:comment xml:lang="en">Year of the GDP per capita baseline.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#vdemYear">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">V-Dem year</rdfs:label>
    <rdfs:comment xml:lang="en">Year of the V-Dem indicators used in the RTLP component crosswalk.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/1">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</skos:notation>
    <skos:prefLabel xml:lang="en">Legal Protections</skos:prefLabel>
    <skos:definition xml:lang="en">Present when ordinary law is applied consistently to state agents as well as everyone else. Absent when power can act without predictable legal constraint. Multiplies GDP by lowering the risk of arbitrary loss; people and businesses invest and trade more when they know the rules will be enforced fairly. Annual cost is low.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever1">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 1: Legal Protections</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/1" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/2">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</skos:notation>
    <skos:prefLabel xml:lang="en">Independent Judiciary</skos:prefLabel>
    <skos:definition xml:lang="en">Present when there is a judiciary capable of upholding right-to-life laws even against the state. These protections represent opportunities for property rights and contracts to support reliable capital flows to productive uses. Annual cost is low relative to the scale unlocked.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever2">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 2: Independent Judiciary</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/2" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/3">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</skos:notation>
    <skos:prefLabel xml:lang="en">Law Enforcement Accountability</skos:prefLabel>
    <skos:definition xml:lang="en">Present when law enforcement agencies are accountable for unlawful killings and violence. These protections represent opportunities to support greater economic scale by reducing arbitrary risk that can deter investment, labor mobility, and everyday economic activity. Annual cost is primarily institutional oversight.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever3">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 3: Law Enforcement Accountability</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/3" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/4">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</skos:notation>
    <skos:prefLabel xml:lang="en">Protection Against Arbitrary Detention</skos:prefLabel>
    <skos:definition xml:lang="en">Present when arbitrary detention is prohibited with real legal recourse. These protections represent opportunities for individuals and families to plan, work, and invest with greater security, supporting scale in the economy. Annual cost is low.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever4">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 4: Protection Against Arbitrary Detention</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/4" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/5">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</skos:notation>
    <skos:prefLabel xml:lang="en">Freedom from Torture and Inhumane Treatment</skos:prefLabel>
    <skos:definition xml:lang="en">Present when the state has effective measures to prevent torture. These protections represent opportunities to support human capital and cooperation. Annual cost is institutional and training: an investment toward realizing greater scale.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever5">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 5: Freedom from Torture and Inhumane Treatment</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/5" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/6">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</skos:notation>
    <skos:prefLabel xml:lang="en">Civilian Protection in Conflict Zones</skos:prefLabel>
    <skos:definition xml:lang="en">Present when mechanisms exist to protect civilians during conflict. These protections represent opportunities to preserve the productive capacity and future of entire regions. Annual cost is primarily military discipline and rules of engagement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever6">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 6: Civilian Protection in Conflict Zones</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/6" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/7">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</skos:notation>
    <skos:prefLabel xml:lang="en">Access to Justice</skos:prefLabel>
    <skos:definition xml:lang="en">Present when ordinary people can bring serious claims and have them heard fairly. These conditions represent opportunities for contracts and rights to function for a wider share of the population. Annual cost is court capacity and legal aid.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever7">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 7: Access to Justice</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/7" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/8">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</skos:notation>
    <skos:prefLabel xml:lang="en">Freedom of Expression and Whistleblower Protections</skos:prefLabel>
    <skos:definition xml:lang="en">Present when laws protect people who report corruption from retaliation. These conditions represent opportunities for information to flow more accurately and for public resources to be used more effectively. Annual cost is low: mainly passing and enforcing the law.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever8">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 8: Freedom of Expression and Whistleblower Protections</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/8" />
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/atlas/2026/lever/9">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://rtldi.org/atlas/2026/scheme/rtldi-levers" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</skos:notation>
    <skos:prefLabel xml:lang="en">Socioeconomic Conditions</skos:prefLabel>
    <skos:definition xml:lang="en">Present when a society makes the deliberate choice to maintain a minimum floor against extreme deprivation. This reflects political will rather than just economic outcomes. When present, it increases the share of the population able to participate productively, expanding overall economic scale. Annual cost is a political decision about minimum security standards.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rtldi.org/ontology#lever9">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
    <rdfs:label xml:lang="en">Lever 9: Socioeconomic Conditions</rdfs:label>
    <rdfs:comment xml:lang="en">Binary RTLP lever value: 1 means present under the atlas threshold; 0 means absent.</rdfs:comment>
    <dcterms:subject rdf:resource="https://rtldi.org/atlas/2026/lever/9" />
  </rdf:Description>
